# This project has no server, so nothing actually reads a .env file at runtime —
# Apps Script only understands Script Properties (Project Settings > Script Properties
# in the Apps Script editor, or `clasp run` against a setup function).
#
# This file exists purely as documentation of every Script Property the bot needs.
# Copy these names (not this file) into Script Properties for your own deployment.

# Slack bot token from your Slack app's "Install App" page (starts with xoxb-)
SLACK_BOT_TOKEN=

# Your Slack member ID (Slack profile > "..." menu > Copy member ID)
SLACK_USER_ID=

# Filled in automatically by the bot on first run via conversations.open — leave blank
SLACK_DM_CHANNEL_ID=

# The Google Sheet acting as persistent state (Reminders/Deliveries/Config/Log
# tabs). Spreadsheet URL looks like .../spreadsheets/d/<this>/edit — create a
# blank Sheet, grab its id, then run `clasp run setupSheet` once to create the tabs.
SHEET_ID=
